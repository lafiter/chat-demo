# 复制为 .env 并填入真实值；.env 不入库

# 模型服务（厂商无关）。协议可选：anthropic | openai-chat | openai-responses
# MODEL_ENDPOINT 必须是完整端点地址，示例：
#   anthropic   智谱：https://open.bigmodel.cn/api/anthropic/v1/messages
#   openai-chat 智谱：https://open.bigmodel.cn/api/paas/v4/chat/completions
#   openai-chat DeepSeek：https://api.deepseek.com/chat/completions
#   openai-chat OpenAI：https://api.openai.com/v1/chat/completions
MODEL_API_KEY=your-api-key
MODEL_ID=glm-5.3
MODEL_PROTOCOL=anthropic
MODEL_ENDPOINT=https://open.bigmodel.cn/api/anthropic/v1/messages

MCP_URL=http://192.168.1.103:8080/mcp/your-connection-id
MCP_TOKEN=your-mcp-bearer-token
MCP_TOOL_TIMEOUT_SEC=600

SITE_ID=your-site-id
DATA_SOURCE_ID=your-datasource-id

PORT=8787
